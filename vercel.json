{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python build_model.py",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{models/**,lib/**,human_typer.py,timing_model.py,api_logic.py}"
    }
  }
}
